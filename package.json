{
  "name": "openclaw-icloud-contacts",
  "version": "0.1.1",
  "description": "OpenClaw plugin: read and write Apple iCloud Contacts server-to-server over CardDAV with an Apple ID and app-specific password. Zero runtime dependencies, runs anywhere Node runs.",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5",
      "minGatewayVersion": "2026.6.5"
    },
    "install": {
      "npmSpec": "openclaw-icloud-contacts",
      "clawhubSpec": "clawhub:openclaw-icloud-contacts",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "files": [
    "dist/",
    "marketplace.json",
    "openclaw.plugin.json",
    "skills/",
    "src/"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "icloud",
    "apple",
    "calendar",
    "caldav"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarshahine/openclaw-icloud-contacts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openclaw": "^2026.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "ICLOUD_INTEGRATION=1 vitest run test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  }
}
